# McKeen Beef website: environment variables (placeholders only, never commit real values).
# Copy to .env.local for development or set in the hosting dashboard for production.
# Details: docs/security.md (§2, §4, §10) and docs/architecture.md.

# ── Public origin ────────────────────────────────────────────────
# Production origin, https, no trailing slash. Used for canonical URLs, hreflang, OG,
# sitemap, JSON-LD and the same-origin check of the form endpoints.
# Without it production falls back to http://localhost:3000 (logged as config.invalid).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Form delivery ────────────────────────────────────────────────
# smtp | resend | log   ("log" is refused in production; forms then answer 503 with direct contacts)
MAIL_PROVIDER=smtp
FORM_FROM_EMAIL=no-reply@example.com
SALES_FORM_RECIPIENT=sales-inbox@example.com
CAREERS_FORM_RECIPIENT=careers-inbox@example.com

# SMTP (MAIL_PROVIDER=smtp). Port 587 + STARTTLS (SMTP_SECURE=false) or 465 (SMTP_SECURE=true).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Resend (MAIL_PROVIDER=resend)
RESEND_API_KEY=

# ── Rate limiting ────────────────────────────────────────────────
# Required for serverless / multi-instance hosting (the in-memory limiter is per instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random 32+ byte value; salts the hashed client IP.
RATE_LIMIT_SALT=

# ── Cloudflare Turnstile (optional) ──────────────────────────────
# Set BOTH or NEITHER. With only one of them the challenge stays off (no widget, no check).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
